# CAMPUS-NEXUS Backend Environment Configuration Example
# Copy to .env and adjust values as needed.

# Database: SQLite fallback works out-of-the-box for local demo; PostgreSQL for production
DATABASE_URL=sqlite:///./campus_nexus.db
DATABASE_FALLBACK_URL=sqlite:///./campus_nexus.db

# Optional Redis Cache (In-memory fallback is automatically used if absent)
REDIS_URL=redis://localhost:6379/0

# Optional MinIO / S3 Object Storage (Local mock fallback is used if absent)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_secret
MINIO_BUCKET_GRIEVANCES=campus-grievances
MINIO_BUCKET_ASSETS=campus-assets

# Authentication & Security
# Change this secret key in production!
JWT_SECRET=campus-nexus-v2-super-secret-jwt-key-2026-hackathon
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate Limiting & Performance
RATE_LIMIT_PER_MINUTE=100
CACHE_TTL_SECONDS=120

# Environment Mode
DEMO_TIME_MULTIPLIER=1.0
ENVIRONMENT=development
# Optional synthetic fixture loading for local demos only. Production ignores it.
LOAD_DEMO_DATA=false
