      <stop offset="0%" stop-color="#042F2E"/>
      <stop offset="100%" stop-color="#021C1B"/>
    </linearGradient>
  </defs>
  <rect width="400" height="500" fill="url(#bgAdmin)"/>
  <circle cx="200" cy="180" r="130" fill="#0D9488" opacity="0.25"/>
