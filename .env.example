# CAMPUS-NEXUS Environment Variables
# Backend FastAPI
DATABASE_URL=sqlite:///./campus_nexus.db
JWT_SECRET=campus-nexus-v2-super-secret-jwt-key-2026-hackathon
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7
