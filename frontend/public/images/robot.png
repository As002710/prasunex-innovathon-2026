<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 400" width="100%" height="100%">
  <defs>
    <radialGradient id="robotGlow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#5EEAD4" stop-opacity="0.6"/>
      <stop offset="50%" stop-color="#0D9488" stop-opacity="0.2"/>
      <stop offset="100%" stop-color="#042F2E" stop-opacity="0"/>
    </radialGradient>
    <linearGradient id="bodyGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#14B8A6"/>
      <stop offset="50%" stop-color="#0F766E"/>
      <stop offset="100%" stop-color="#042F2E"/>
    </linearGradient>
    <linearGradient id="faceGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#041E1A"/>
      <stop offset="100%" stop-color="#021411"/>
    </linearGradient>
    <linearGradient id="capGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0D5C4E"/>
      <stop offset="100%" stop-color="#031F1B"/>
    </linearGradient>
    <linearGradient id="tabletGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0F766E"/>
      <stop offset="100%" stop-color="#042F2E"/>
    </linearGradient>
    <filter id="neon" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="5" result="blur"/>
      <feMerge>
        <feMergeNode in="blur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>

  <!-- Aura Glow -->
  <circle cx="200" cy="200" r="160" fill="url(#robotGlow)" />

  <!-- Base Orbit Ring -->
  <ellipse cx="200" cy="330" rx="110" ry="24" fill="none" stroke="#2DD4BF" stroke-width="3" stroke-dasharray="8 6" opacity="0.6" filter="url(#neon)"/>
  <ellipse cx="200" cy="340" rx="70" ry="16" fill="none" stroke="#5EEAD4" stroke-width="2" opacity="0.4"/>

  <!-- Robot Body -->
  <rect x="140" y="210" width="120" height="95" rx="30" fill="url(#bodyGrad)" stroke="#5EEAD4" stroke-width="2.5"/>
  <!-- Body Core Circle -->
  <circle cx="200" cy="255" r="22" fill="#042420" stroke="#2DD4BF" stroke-width="2"/>
  <polygon points="194,248 208,255 194,262" fill="#5EEAD4" filter="url(#neon)"/>

  <!-- Robot Arms -->
  <!-- Left Arm holding tablet -->
  <path d="M 140 230 C 110 245, 115 275, 135 295" fill="none" stroke="#14B8A6" stroke-width="14" stroke-linecap="round"/>
  <!-- Right Arm -->
  <path d="M 260 230 C 285 245, 285 275, 265 295" fill="none" stroke="#14B8A6" stroke-width="14" stroke-linecap="round"/>

  <!-- Tablet / Open Pad -->
  <g transform="translate(145, 265)">
    <rect x="0" y="0" width="110" height="70" rx="10" fill="url(#tabletGrad)" stroke="#5EEAD4" stroke-width="2" filter="url(#neon)"/>
    <rect x="6" y="6" width="98" height="58" rx="6" fill="#021B17"/>
    <!-- Open Book Icon on tablet -->
    <path d="M 32 30 Q 42 24 55 27 Q 68 24 78 30 L 78 45 Q 68 40 55 42 Q 42 40 32 45 Z" fill="none" stroke="#5EEAD4" stroke-width="2" filter="url(#neon)"/>
    <line x1="55" y1="27" x2="55" y2="42" stroke="#5EEAD4" stroke-width="2"/>
    <line x1="38" y1="52" x2="72" y2="52" stroke="#2DD4BF" stroke-width="2" stroke-linecap="round"/>
  </g>

  <!-- Robot Head -->
  <rect x="130" y="115" width="140" height="100" rx="36" fill="url(#bodyGrad)" stroke="#5EEAD4" stroke-width="3"/>
  
  <!-- Face Screen -->
  <rect x="145" y="130" width="110" height="70" rx="22" fill="url(#faceGrad)" stroke="#14B8A6" stroke-width="1.5"/>

  <!-- Glowing Cyan Eyes (Happy Arc / Pill) -->
  <ellipse cx="175" cy="160" rx="14" ry="10" fill="#22D3EE" filter="url(#neon)"/>
  <ellipse cx="225" cy="160" rx="14" ry="10" fill="#22D3EE" filter="url(#neon)"/>
  <!-- Eye pupil reflections -->
  <circle cx="178" cy="157" r="4" fill="#FFFFFF"/>
  <circle cx="228" cy="157" r="4" fill="#FFFFFF"/>

  <!-- Robot Smile -->
  <path d="M 188 180 Q 200 188 212 180" fill="none" stroke="#22D3EE" stroke-width="3" stroke-linecap="round" filter="url(#neon)"/>

  <!-- Antenna -->
  <line x1="200" y1="115" x2="200" y2="92" stroke="#5EEAD4" stroke-width="4"/>
  <circle cx="200" cy="88" r="8" fill="#F5B942" stroke="#FBBF24" stroke-width="2" filter="url(#neon)"/>

  <!-- Graduation Cap (Mortarboard) -->
  <polygon points="200,68 290,95 200,118 110,95" fill="url(#capGrad)" stroke="#5EEAD4" stroke-width="2.5"/>
  <polygon points="160,113 240,113 225,124 175,124" fill="#031F1B" stroke="#2DD4BF" stroke-width="1.5"/>
  <!-- Tassel -->
  <circle cx="200" cy="93" r="4" fill="#F5B942"/>
  <path d="M 200 93 Q 235 105 245 130" fill="none" stroke="#F5B942" stroke-width="2.5"/>
  <polygon points="241,130 249,130 245,142" fill="#F5B942"/>
</svg>
