<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 500" width="100%" height="100%">
  <defs>
    <linearGradient id="bgProf" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#115E59"/>
      <stop offset="100%" stop-color="#042F2E"/>
    </linearGradient>
  </defs>
  <rect width="400" height="500" fill="url(#bgProf)"/>
  <circle cx="200" cy="180" r="130" fill="#14B8A6" opacity="0.2"/>
  <!-- Head -->
  <circle cx="200" cy="155" r="50" fill="#F0FDFA"/>
  <!-- Hair & Beard -->
  <path d="M 150 145 Q 200 110 250 145 Q 200 115 150 145 Z" fill="#134E4A"/>
  <!-- Glasses -->
  <rect x="170" y="145" width="24" height="16" rx="3" fill="none" stroke="#134E4A" stroke-width="3"/>
  <rect x="206" y="145" width="24" height="16" rx="3" fill="none" stroke="#134E4A" stroke-width="3"/>
  <line x1="194" y1="152" x2="206" y2="152" stroke="#134E4A" stroke-width="3"/>
  <!-- Blazer / Tie -->
  <path d="M 120 270 C 120 220, 160 215, 200 215 C 240 215, 280 220, 280 270 L 290 420 L 110 420 Z" fill="#0D5C4E"/>
  <polygon points="175,215 225,215 200,320" fill="#F0FDFA"/>
  <polygon points="195,225 205,225 202,300 198,300" fill="#0F766E"/>
  <!-- Holding Tablet/Book -->
  <rect x="150" y="310" width="100" height="70" rx="8" fill="#042F2E" stroke="#5EEAD4" stroke-width="2"/>
  <line x1="165" y1="335" x2="235" y2="335" stroke="#2DD4BF" stroke-width="2"/>
  <line x1="165" y1="350" x2="215" y2="350" stroke="#2DD4BF" stroke-width="2"/>
</svg>
