<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 800" width="100%" height="100%">
  <defs>
    <linearGradient id="nightSky" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#021411"/>
      <stop offset="60%" stop-color="#052720"/>
      <stop offset="100%" stop-color="#093C32"/>
    </linearGradient>
    <linearGradient id="glassWall" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0D4F42"/>
      <stop offset="100%" stop-color="#062821"/>
    </linearGradient>
    <linearGradient id="windowGlowWarm" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#FDE68A" stop-opacity="0.9"/>
      <stop offset="100%" stop-color="#F59E0B" stop-opacity="0.7"/>
    </linearGradient>
    <linearGradient id="windowGlowMint" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#5EEAD4" stop-opacity="0.8"/>
      <stop offset="100%" stop-color="#0D9488" stop-opacity="0.6"/>
    </linearGradient>
    <linearGradient id="pondReflection" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#072C24"/>
      <stop offset="50%" stop-color="#031A15"/>
      <stop offset="100%" stop-color="#02110E"/>
    </linearGradient>
    <filter id="softGlow">
      <feGaussianBlur stdDeviation="8" result="blur"/>
      <feMerge>
        <feMergeNode in="blur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>

  <!-- Night Sky Backdrop -->
  <rect width="1200" height="800" fill="url(#nightSky)"/>

  <!-- Stars -->
  <circle cx="120" cy="80" r="1.5" fill="#E6FFFA" opacity="0.8"/>
  <circle cx="280" cy="60" r="1.2" fill="#E6FFFA" opacity="0.6"/>
  <circle cx="450" cy="110" r="2" fill="#5EEAD4" opacity="0.9"/>
  <circle cx="680" cy="70" r="1" fill="#E6FFFA" opacity="0.5"/>
  <circle cx="890" cy="130" r="1.8" fill="#5EEAD4" opacity="0.8"/>
  <circle cx="1050" cy="90" r="1.2" fill="#E6FFFA" opacity="0.7"/>
  <circle cx="980" cy="160" r="1.5" fill="#FDE68A" opacity="0.7"/>
  <circle cx="150" cy="170" r="1.3" fill="#E6FFFA" opacity="0.6"/>
  
  <!-- Aurora / Cyber Glow Waves -->
  <path d="M 0 250 Q 350 180 700 240 T 1200 190" fill="none" stroke="#2DD4BF" stroke-width="2" opacity="0.3" filter="url(#softGlow)"/>
  <path d="M 0 280 Q 400 200 800 270 T 1200 230" fill="none" stroke="#00F5A0" stroke-width="1.5" opacity="0.2"/>

  <!-- Distant Silhouette Trees & Lawn -->
  <path d="M 0 520 Q 250 490 600 510 T 1200 500 L 1200 600 L 0 600 Z" fill="#04201A"/>

  <!-- Modern University Building - Architecture Wings -->
  <!-- Left Wing -->
  <rect x="250" y="240" width="220" height="280" fill="url(#glassWall)" stroke="#115E59" stroke-width="2"/>
  <!-- Windows Grid Left -->
  <g fill="url(#windowGlowWarm)" opacity="0.75">
    <rect x="270" y="260" width="28" height="40" rx="3"/><rect x="310" y="260" width="28" height="40" rx="3"/><rect x="350" y="260" width="28" height="40" rx="3"/><rect x="390" y="260" width="28" height="40" rx="3"/>
    <rect x="270" y="320" width="28" height="40" rx="3"/><rect x="310" y="320" width="28" height="40" rx="3"/><rect x="350" y="320" width="28" height="40" rx="3"/><rect x="390" y="320" width="28" height="40" rx="3"/>
    <rect x="270" y="380" width="28" height="40" rx="3"/><rect x="310" y="380" width="28" height="40" rx="3"/><rect x="350" y="380" width="28" height="40" rx="3"/><rect x="390" y="380" width="28" height="40" rx="3"/>
    <rect x="270" y="440" width="28" height="40" rx="3"/><rect x="310" y="440" width="28" height="40" rx="3"/><rect x="350" y="440" width="28" height="40" rx="3"/><rect x="390" y="440" width="28" height="40" rx="3"/>
  </g>

  <!-- Central Glass Atrium (High Tech Glass Facade) -->
  <rect x="470" y="160" width="260" height="360" fill="#06332A" stroke="#2DD4BF" stroke-width="2" filter="url(#softGlow)"/>
  <!-- Atrium Diagonal Structural Trusses -->
  <line x1="470" y1="160" x2="730" y2="520" stroke="#14B8A6" stroke-width="1.5" opacity="0.5"/>
  <line x1="730" y1="160" x2="470" y2="520" stroke="#14B8A6" stroke-width="1.5" opacity="0.5"/>
  <line x1="470" y1="340" x2="730" y2="340" stroke="#2DD4BF" stroke-width="2" opacity="0.6"/>
  <!-- Atrium Windows Glow (Mint/Cyan) -->
  <g fill="url(#windowGlowMint)">
    <rect x="495" y="180" width="40" height="60" rx="4" opacity="0.85"/>
    <rect x="550" y="180" width="40" height="60" rx="4" opacity="0.9"/>
    <rect x="605" y="180" width="40" height="60" rx="4" opacity="0.85"/>
    <rect x="665" y="180" width="40" height="60" rx="4" opacity="0.9"/>

    <rect x="495" y="260" width="40" height="60" rx="4" opacity="0.7"/>
    <rect x="550" y="260" width="40" height="60" rx="4" opacity="0.95"/>
    <rect x="605" y="260" width="40" height="60" rx="4" opacity="0.95"/>
    <rect x="665" y="260" width="40" height="60" rx="4" opacity="0.7"/>

    <rect x="495" y="360" width="40" height="60" rx="4" opacity="0.85"/>
    <rect x="550" y="360" width="40" height="60" rx="4" opacity="0.9"/>
    <rect x="605" y="360" width="40" height="60" rx="4" opacity="0.9"/>
    <rect x="665" y="360" width="40" height="60" rx="4" opacity="0.85"/>

    <!-- Grand Entrance Gateway -->
    <rect x="560" y="450" width="80" height="70" rx="6" fill="#FDE68A" opacity="0.95" filter="url(#softGlow)"/>
  </g>

  <!-- Right Wing -->
  <rect x="730" y="220" width="240" height="300" fill="url(#glassWall)" stroke="#115E59" stroke-width="2"/>
  <!-- Windows Grid Right -->
  <g fill="url(#windowGlowWarm)" opacity="0.75">
    <rect x="750" y="240" width="30" height="45" rx="3"/><rect x="795" y="240" width="30" height="45" rx="3"/><rect x="840" y="240" width="30" height="45" rx="3"/><rect x="885" y="240" width="30" height="45" rx="3"/>
    <rect x="750" y="305" width="30" height="45" rx="3"/><rect x="795" y="305" width="30" height="45" rx="3"/><rect x="840" y="305" width="30" height="45" rx="3"/><rect x="885" y="305" width="30" height="45" rx="3"/>
    <rect x="750" y="370" width="30" height="45" rx="3"/><rect x="795" y="370" width="30" height="45" rx="3"/><rect x="840" y="370" width="30" height="45" rx="3"/><rect x="885" y="370" width="30" height="45" rx="3"/>
    <rect x="750" y="435" width="30" height="45" rx="3"/><rect x="795" y="435" width="30" height="45" rx="3"/><rect x="840" y="435" width="30" height="45" rx="3"/><rect x="885" y="435" width="30" height="45" rx="3"/>
  </g>

  <!-- Architectural Cornice & Roof Lights -->
  <line x1="240" y1="240" x2="470" y2="240" stroke="#5EEAD4" stroke-width="3" filter="url(#softGlow)"/>
  <line x1="460" y1="160" x2="740" y2="160" stroke="#00F5A0" stroke-width="4" filter="url(#softGlow)"/>
  <line x1="730" y1="220" x2="980" y2="220" stroke="#5EEAD4" stroke-width="3" filter="url(#softGlow)"/>

  <!-- Campus Lawn & Promenade -->
  <polygon points="0,520 1200,520 1200,600 0,600" fill="#042720"/>
  <!-- Promenade Walkway -->
  <polygon points="350,600 850,600 700,520 500,520" fill="#073A2F" stroke="#14B8A6" stroke-width="1"/>

  <!-- Reflection Pond & Water Basin -->
  <rect x="0" y="600" width="1200" height="200" fill="url(#pondReflection)"/>
  <!-- Mirrored Glow Ripples -->
  <ellipse cx="600" cy="660" rx="320" ry="15" fill="#0D9488" opacity="0.3" filter="url(#softGlow)"/>
  <ellipse cx="600" cy="710" rx="420" ry="20" fill="#042F2E" opacity="0.5"/>
  <line x1="560" y1="620" x2="640" y2="620" stroke="#FDE68A" stroke-width="2" opacity="0.6"/>
  <line x1="530" y1="640" x2="670" y2="640" stroke="#5EEAD4" stroke-width="2" opacity="0.5"/>
  <line x1="490" y1="680" x2="710" y2="680" stroke="#2DD4BF" stroke-width="1.5" opacity="0.4"/>
</svg>
